# Copy this to /home/.env on each OpenComputers machine and fill in what that
# machine needs. Everything is optional; anything left out falls back to the
# default compiled into the program.
#
# This file is the one thing update.lua never overwrites, so settings and
# secrets here survive every update.
#
#   cp .env.example /home/.env   (then edit)

# ---- networking -------------------------------------------------------------
# The proxy computer's modem address, printed by proxy.lua on startup.
# Leave it out and the client discovers the proxy automatically on first use,
# then writes the answer back here.
# PROXY_ADDRESS=e66d90a3-8a83-4b8a-930a-2aecdfaefb59

# Seconds http.lua waits for a reply. Local model inference is slow; the
# Ollama client raises this to 180 on its own.
# HTTP_TIMEOUT=180

# ---- ollama.lua -------------------------------------------------------------
# Where Ollama listens, as seen FROM THE PROXY COMPUTER's Internet Card.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=600
# OLLAMA_TEMPERATURE=0.6

# ---- update.lua -------------------------------------------------------------
# UPDATE_REPO=SlammingSam/open-computer-skyfactory
# UPDATE_BRANCH=main
# A personal access token only raises GitHub's rate limit. It needs no scopes
# for a public repo. THIS IS A SECRET - never commit a filled-in .env.
# GITHUB_TOKEN=

# ---- claude.lua -------------------------------------------------------------
# ANTHROPIC_API_KEY=
